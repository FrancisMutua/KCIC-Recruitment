<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <BuildProjectReferences>true</BuildProjectReferences>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)/../../../Live/</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
  </PropertyGroup>
  <Target Name="ValidateLivePublishOutput" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)Garissa-Recruitment.Server.dll')"
           Text="Publishing failed: Garissa-Recruitment.Server.dll is missing from the output." />
    <Error Condition="!Exists('$(PublishDir)wwwroot/index.html')"
           Text="Publishing failed: the frontend is missing. Publish with project references enabled." />
  </Target>
</Project>
